# fixture (default without GITHUB_TOKEN) | live
APP_MODE=fixture

# Required only for live GitHub ingestion (read-only public_repo / repo scope)
GITHUB_TOKEN=

# Required only for live Grok narratives; without this key the deterministic fixture narrative is used
# Get a key from https://console.x.ai/
XAI_API_KEY=
# Optional alias for XAI_API_KEY
# GROK_API_KEY=

XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# SQLite file path
DB_PATH=./data/insights.sqlite

# How long cached GitHub data is considered fresh (seconds)
CACHE_TTL_SECONDS=900
